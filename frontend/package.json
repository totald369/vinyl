{
  "name": "map-store-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev.js",
    "dev:fast": "NEXT_DEV_KEEP_CACHE=1 node scripts/next-dev.js",
    "dev:clean": "rm -rf .next && node scripts/next-dev.js",
    "dev:poll": "rm -rf .next && NEXT_DEV_POLL=1 node scripts/next-dev.js",
    "build": "tsx scripts/build-merged-cache.ts && node scripts/generate-map-placeholder.mjs && next build",
    "data:build-cache": "tsx scripts/build-merged-cache.ts",
    "start": "next start",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "shortcodes:assign": "tsx scripts/assignShortCodes.ts",
    "data:import-reports-csv": "tsx scripts/importReportsCsv.ts",
    "data:import-guro-nc": "python3 scripts/importGuroNoncombustFromXlsx.py",
    "data:import-chungnam-trash": "python3 scripts/import_chungnam_trash_from_xlsx.py",
    "data:import-chungnam-gongju-trash": "python3 scripts/import_chungnam_gongju_trash_from_xlsx.py",
    "data:import-chungnam-gongju-special": "python3 scripts/import_chungnam_gongju_special_from_web.py",
    "data:import-chungbuk-jeungpyeong-trash": "python3 scripts/import_chungbuk_jeungpyeong_trash_from_xls.py",
    "data:import-seoul-yangcheon-special": "python3 scripts/import_seoul_yangcheon_special_xlsx.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-virtual": "^3.13.24",
    "es-hangul": "^2.3.8",
    "lottie-react": "^2.4.1",
    "next": "^14.2.18",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all",
    "not ie 11"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "iconv-lite": "^0.7.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
